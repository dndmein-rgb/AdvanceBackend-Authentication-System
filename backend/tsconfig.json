{
  "compilerOptions": {

    "target": "ES2022",

    "module": "NodeNext",
    "types": ["node"],

    "moduleResolution": "NodeNext",

    "outDir": "./dist",

    "rootDir": "./src",

    "strict": true,

    "esModuleInterop": true,

    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,

    "noImplicitAny": true,

    "noUnusedLocals": true,

    "noUnusedParameters": true,

    "exactOptionalPropertyTypes": true
  },

  "include": [
    "src"
  ]
}